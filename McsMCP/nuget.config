<?xml version="1.0" encoding="utf-8"?>
<!--
  Redirect the NuGet package folder to a repo-local path.

  WHY this is needed rather than using the default ~/.nuget/packages: on this machine the user-level
  cache is on a read-only mount, so restoring ILRepack.Lib.MSBuild.Task into it fails outright with

      error : Read-only file system : '/home/huang/.nuget/packages/ilrepack.lib.msbuild.task'

  which reads like a transient NuGet problem but is a hard permission failure. Keeping the folder
  under the repo also means the build does not depend on what happens to be cached globally, and it
  is already listed in .gitignore via the 'local/' + '**/obj' patterns (see the repo .gitignore note
  added alongside this file).

  Same approach as LongYinMods/MelonMCP/nuget.config.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
    <add key="http_cache_path" value=".nuget/http-cache" />
  </config>
</configuration>
